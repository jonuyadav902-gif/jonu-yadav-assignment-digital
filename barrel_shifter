module Barrel_shifter(
input [15:0] data_in,
input [3:0] controlsign,
input logshift,
input arithshift,
output reg [15:0] data_out
    );

    always @(*)
    begin
    case ({logshift,arithshift})
    2'b00 : data_out = data_in << controlsign;
     2'b10 : data_out = data_in>>controlsign;
     2'b01 : data_out = data_in <<< controlsign;
      2'b11 : data_out = data_in >>> controlsign;
      default : data_out = data_in;
      endcase
      end

      
    
    
endmodule
