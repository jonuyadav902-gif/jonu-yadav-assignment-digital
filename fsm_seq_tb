module tb_Seq_div_5_Mealy;

    reg clk, rst, din;
    wire rangdetect;

    Seq_div_5_Mealy dut (
        .clk(clk),
        .rst(rst),
        .din(din),
        .rangdetect(rangdetect)
    );

   
    always #5 clk = ~clk;

    initial begin
        clk = 0;
        rst = 1;
        din = 0;

        #10 rst = 0; 
        @(posedge clk) din = 1;
        @(posedge clk) din = 0;
        @(posedge clk) din = 1;
        @(posedge clk) din = 0; 
        @(posedge clk) din = 0;
        @(posedge clk) din = 0;

        #20 $finish;
    end

endmodule