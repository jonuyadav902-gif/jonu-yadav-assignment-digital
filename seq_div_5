module Seq_div_5_Mealy (
    input logic clk,
    input  logic rst,
    input  logic din,
    output logic rangdetect
);
 logic  [7:0]  count; 
    parameter A = 3'b000;
    parameter B = 3'b001;
    parameter C = 3'b010;
    parameter D = 3'b011;
    parameter E = 3'b100;

    logic [2:0] ps, ns;
    always_ff @(posedge clk) begin
        if (rst)
            ps <= A;
        else
            ps <= ns;
    end
    
    always_ff @(*) begin
        case (ps)
            A: ns = din ? B : A;
            B: ns = din ? D : C;
            C: ns = din ? A : E;
            D: ns = din ? C : B;
            E: ns = din ? E : D;
            default: ns = A;
        endcase
    end

   
    always_ff @(posedge clk) begin
        if (rst) begin
            rangdetect <= 1'b0;
            count <= 8'd0;
            end
        else begin
            rangdetect <= (ns == A);
            if (ns == A)  
             count <= count + 1 ;
             end
    end

endmodule
