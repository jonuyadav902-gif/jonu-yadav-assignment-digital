module full_adder(
input logic a,
input logic b,
input logic cin,
output logic sum,
output logic cout
    );
    `ifdef STRUCT 
    // STRUTURAL
    logic x1,x2,x3;
    xor (x1,a,b);
    xor (sum,x1,cin);
    and (x3,x1,cin);
    and (x2,a,b);
    or (cout,x2,x3);  
    
    `elseif DATA_FLOW   
    //DATAFLOWK
    assign sum = a^b^cin;
    assign cout = (a&b)|(b&cin)|(cin&a);
    
    `else 
   //BEHAVORIAL 
   always_comb begin
  sum = a^b^cin;
  cout = (a&b)|(b&cin)|(cin&a);
   end 
   initial $display ("sum %0d, cout%0d",sum,cout);
   `endif
endmodule
