module tb_Seq_div_5_Mealy;

    logic clk;
    logic rst;
    logic din;
    logic rangdetect;

    // DUT instantiation
    Seq_div_5_Mealy dut (
        .clk(clk),
        .rst(rst),
        .din(din),
        .rangdetect(rangdetect)
    );

    // Clock generation (10ns period)
    initial
    begin
    clk = 0;
    forever #5 clk = ~clk;
    end
    
    initial begin
        clk = 0;
        rst = 1;
        din = 0;

        // Apply reset
        #10;
        rst = 0;

        // Apply input sequence: 101010
        #10 din = 0;
        #10 din = 0;
        #10 din = 1;
        #10 din = 0;
        #10 din = 1;
        #10 din = 0;

        #20;
        $finish;
    end

    // Monitor signals
    initial begin
        $monitor("time=%0t din=%b rangdetect=%b count=%0d",
                  $time, din, rangdetect, dut.count);
    end

endmodule
